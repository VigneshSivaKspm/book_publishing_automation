# ==============================================================================
# BOOK PUBLISHING AUTOMATION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPENAI CHATGPT PAID API KEY
# ------------------------------------------------------------------------------
# Paste your paid ChatGPT Secret API Key below (starts with sk-proj- or sk-...).
# This key is used for gpt-4o OCR Vision scanning, Tamil/English structuring,
# and MCQ auto-solving.
# ------------------------------------------------------------------------------
VITE_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. GOOGLE SERVICE ACCOUNT KEY
# ------------------------------------------------------------------------------
# Paste your Google Service Account JSON Key or Key content below.
# Used for Google Drive & Cloud integrations.
# ------------------------------------------------------------------------------
# Option A: Full JSON key string or JSON key file path
VITE_GOOGLE_SERVICE_ACCOUNT_KEY=your_google_service_account_json_key_here
GOOGLE_SERVICE_ACCOUNT_KEY=your_google_service_account_json_key_here

# Option B: Individual Service Account fields (if using separate environment values)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
