# ---------------------------------------------------------------------------
# Publication Studio — OCR → Book → Print server configuration
# Copy to `.env.server` (or set in the host environment). These values are read
# ONLY by the Node server (npm run server) and are never sent to the browser.
# Never prefix secrets with VITE_ — VITE_ variables are bundled into the app.
# ---------------------------------------------------------------------------

# Required for OCR / document understanding
OPENAI_API_KEY=

# Models (Responses API). Defaults shown; change without touching code.
OPENAI_OCR_MODEL=gpt-5
OPENAI_STRUCTURE_MODEL=gpt-5
OPENAI_VALIDATION_MODEL=gpt-5-mini
# minimal | low | medium | high  (reasoning models only)
OPENAI_REASONING_EFFORT=low

# Pipeline tuning
OCR_CONCURRENCY=4
OCR_MAX_ATTEMPTS=4
OCR_TIMEOUT_MS=240000
OCR_DPI=300
OCR_DPI_DENSE=400
MAX_UPLOAD_MB=200
MAX_PAGES=600

# Server
API_PORT=8787
DATA_DIR=data
# Optional shared secret; when set every /api call needs `Authorization: Bearer <token>`
APP_ACCESS_TOKEN=
# Chrome / Edge / Chromium used for pagination and PDF output (auto-detected if blank)
CHROME_PATH=
